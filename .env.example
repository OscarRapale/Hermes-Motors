# Copy to .env.local for local development. Set the same names in Vercel (ARCHITECTURE §15).

# Canonical origin for metadata, sitemap and share links, no trailing slash.
# Optional: when unset on Vercel, the code falls back to https://$VERCEL_PROJECT_PRODUCTION_URL
# (the *.vercel.app address), then to http://localhost:3000. Set it only if a domain is bought (Decision D5).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. "vercel" turns on Vercel Web Analytics (cookieless) if Oscar opts in (Decision D6).
# Leave empty for no analytics.
NEXT_PUBLIC_ANALYTICS=
